<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.basic.chap05.MemoMapper">

    <select id="list" resultType="com.example.basic.chap05.MemoVO">
        SELECT
            MNO,
            MEMO,
            PHONE,
            SECRET
        FROM MEMO
        ORDER BY MNO DESC
    </select>

    <insert id="memoRegist" parameterType="com.example.basic.chap05.MemoVO">
        INSERT INTO MEMO (MNO, MEMO, PHONE, PW, SECRET)
        VALUES (
                   MEMO_SEQ.NEXTVAL,
                   #{memo},
                   #{phone},
                   #{pw},
                   #{secret}
               )
    </insert>

    <delete id="memoDelete" parameterType="com.example.basic.chap05.MemoVO">
        DELETE FROM MEMO
        WHERE MNO = #{mno}
    </delete>

</mapper>